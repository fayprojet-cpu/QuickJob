# ═══════════════════════════════════════════════════════════════════
#  QuickJob — variables d'environnement (template)
#  Copie ce fichier en `.env` et renseigne les valeurs.
#  ⚠️  Le `.env` réel n'est JAMAIS commité (voir .gitignore du workspace).
#  Aucune devise / langue / région n'est fixée ici : tout est config marché.
# ═══════════════════════════════════════════════════════════════════

# --- Général ---
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Base de données (doit matcher docker-compose.yml) ---
POSTGRES_USER=quickjob
POSTGRES_PASSWORD=quickjob
POSTGRES_DB=quickjob
POSTGRES_PORT=5432
DATABASE_URL=postgresql://quickjob:quickjob@localhost:5432/quickjob?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=

# --- Sélection des providers par défaut (interchangeables) ---
PAYMENT_DEFAULT_PROVIDER=stripe
STORAGE_DEFAULT_PROVIDER=s3
SMS_DEFAULT_PROVIDER=twilio
EMAIL_DEFAULT_PROVIDER=sendgrid
PUSH_DEFAULT_PROVIDER=fcm

# --- Paiements ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Mobile Money : interface générique, clés propres à chaque opérateur local
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_API_SECRET=

# --- Stockage objet (S3-compatible : AWS S3 / R2 / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=quickjob
S3_ACCESS_KEY=quickjob
S3_SECRET_KEY=quickjob-secret

# --- SMS / Email / Push ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
FCM_SERVICE_ACCOUNT_JSON=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# --- Email transactionnel (mot de passe oublié, etc.) ---
# Voir docs/EMAIL-SETUP.md.
# BREVO_API_KEY : envoi via l'API HTTP de Brevo (port 443) — À UTILISER EN
# PRODUCTION sur Render, qui bloque les connexions SMTP sortantes (port 587).
# Si absent, on retombe sur SMTP_* (utile en dev local). Si tout est vide,
# l'API bascule automatiquement sur un envoi "console" (lien loggé, pas envoyé).
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=QuickJob <no-reply@quickjob.local>

# --- Paiement Mobile Money (FedaPay) — voir docs/PAYMENTS-SETUP.md ---
# FEDAPAY_ENVIRONMENT: "sandbox" ou "live" (doit correspondre au préfixe des
# clés : pk_live_.../sk_live_... -> "live", pk_sandbox_.../sk_sandbox_... ->
# "sandbox"). Si FEDAPAY_SECRET_KEY est vide, l'API refuse la création de
# transaction avec une erreur claire (503) au lieu de planter au démarrage.
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_ENVIRONMENT=sandbox
# Rempli après coup, une fois le webhook créé dans le tableau de bord FedaPay
# (nécessite une URL publique déployée). Absent -> le webhook revérifie quand
# même le vrai statut via l'API FedaPay avant de faire confiance à quoi que
# ce soit.
FEDAPAY_WEBHOOK_SECRET=

# --- IA / Matching ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PINECONE_API_KEY=
PINECONE_INDEX=quickjob

# --- Taux de change (provider configurable) ---
FX_PROVIDER_API_KEY=

# --- Observabilité ---
SENTRY_DSN=

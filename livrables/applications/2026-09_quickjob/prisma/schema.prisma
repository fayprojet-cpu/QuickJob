// ═══════════════════════════════════════════════════════════════════════════
//  QuickJob — Schéma Prisma (PostgreSQL 16)
// ───────────────────────────────────────────────────────────────────────────
//  PRINCIPES NON NÉGOCIABLES appliqués dans ce schéma :
//
//  1. AUCUNE devise, région ou langue hardcodée.
//     - Les montants suivent le pattern « Money » : un entier `*Amount` en
//       UNITÉS MINEURES (centimes) stocké en BigInt + un `*Currency` (code
//       ISO 4217, ex. "EUR", "USD", "XOF"). Jamais de Float pour l'argent.
//     - Les pays sont des codes ISO 3166-1 alpha-2 (ex. "FR", "CI", "NG").
//     - Les langues sont des locales BCP 47 (ex. "fr", "en", "fr-CI").
//     - La configuration par marché vit dans `SystemConfig` / `Market`,
//       modifiable depuis l'admin sans redéploiement.
//
//  2. Toutes les dates sont stockées en UTC (`DateTime`). La conversion vers
//     le fuseau de l'utilisateur se fait côté client.
//
//  3. Les libellés affichables (catégories, compétences) référencent une clé
//     i18n (`labelKey`) et non un texte figé.
//
//  4. `AuditLog` est en append-only (aucune update/delete applicative).
//
//  NB géospatial : la recherche par rayon utilise l'extension PostGIS
//  (colonne géographique gérée par migration SQL) OU un préfiltre bounding-box
//  sur (latitude, longitude) indexés + Haversine applicatif. On stocke ici
//  lat/lng en Decimal ; l'index géo fin est ajouté via migration.
//  Les embeddings sémantiques vivent dans Pinecone ; la table `EmbeddingRef`
//  ne garde qu'un pointeur.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Connexion directe (hors pooler PgBouncer) requise par `prisma migrate` :
  // le mode transaction du pooler ne supporte pas les advisory locks/DDL.
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, postgis(schema: "public")]
}

// ═══════════════════════════════════════════════════════════════════════════
//  ENUMS
// ═══════════════════════════════════════════════════════════════════════════

enum UserRole {
  WORKER
  RECRUITER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

enum OtpChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  PASSWORD_RESET
  WITHDRAWAL
}

enum TwoFactorMethod {
  TOTP
  SMS
}

enum RecruiterType {
  INDIVIDUAL
  SME
  ENTERPRISE
}

enum WorkerLevel {
  BEGINNER
  BRONZE
  SILVER
  GOLD
  ELITE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IdDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVER_LICENSE
  RESIDENCE_PERMIT
}

enum SalaryType {
  FIXED
  HOURLY
  DAILY
}

enum JobUrgency {
  FLEXIBLE
  THIS_WEEK
  TODAY
  URGENT
}

enum JobStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}

enum RecurrenceFrequency {
  NONE
  WEEKLY
  MONTHLY
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  LOCATION
  SYSTEM
}

enum WalletTxnType {
  CREDIT
  DEBIT
}

enum WalletTxnReason {
  ESCROW_FUNDING
  ESCROW_RELEASE
  ESCROW_REFUND
  WITHDRAWAL
  DEPOSIT
  COMMISSION
  BOOST
  SUBSCRIPTION
  ADJUSTMENT
}

enum PaymentPurpose {
  ESCROW_FUNDING
  WALLET_TOPUP
  BOOST
  SUBSCRIPTION
  EXPRESS_VERIFICATION
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProviderKey {
  STRIPE
  PAYPAL
  MOBILE_MONEY
  BANK_TRANSFER
  INTERNAL_WALLET
}

enum EscrowStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_RELEASE
  RESOLVED_REFUND
  RESOLVED_PARTIAL
}

enum ReviewDirection {
  RECRUITER_TO_WORKER
  WORKER_TO_RECRUITER
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
  FLAGGED
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum PushProvider {
  FCM
  ONESIGNAL
}

enum SubscriptionPlan {
  FREE
  PRO_WORKER
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum FraudSignalType {
  MULTIPLE_ACCOUNTS
  FAKE_REVIEW
  SUSPICIOUS_PAYMENT
  ABNORMAL_BEHAVIOR
  DUPLICATE_JOB
}

enum FraudSignalStatus {
  OPEN
  REVIEWING
  CONFIRMED
  DISMISSED
}

// ═══════════════════════════════════════════════════════════════════════════
//  MODULE 1 — IDENTITÉ, AUTH, PROFILS
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?    @unique
  phone           String?    @unique // format E.164, ex. "+2250700000000"
  passwordHash    String?
  // Nullable : obligatoire à l'inscription pour les nouveaux comptes, mais
  // absent pour les comptes créés avant l'ajout de ce champ — l'app leur
  // demande de le renseigner plutôt que de casser leur session.
  firstName       String?
  // URL publique de la photo de profil (stockage Supabase) — un seul avatar
  // par personne, partagé entre son rôle travailleur et recruteur.
  avatarUrl       String?
  roles           UserRole[] @default([WORKER])
  status          UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  // Préférences localisées — jamais de valeur hardcodée côté code.
  locale          String     @default("en") // BCP 47
  currency        String     @default("USD") // ISO 4217
  countryCode     String?    // ISO 3166-1 alpha-2
  timezone        String     @default("UTC")

  trustScore      Int        @default(0) // 0-100, recalculé après chaque mission

  // Profil polyvalent (côté travailleur) — ce que la personne accepte de
  // faire en plus de ses compétences (voir UserSkill) : petits boulots
  // simples, sans lien avec un métier précis.
  canDoGeneral         Boolean  @default(false)
  // Sous-ensemble de JobCategory.key acceptés comme "mission simple"
  // (ex. "category.delivery") — réutilise le catalogue de catégories des
  // missions plutôt qu'une liste séparée.
  acceptedCategoryKeys String[] @default([])
  availableNow         Boolean  @default(false)

  // Zone de la personne. IMPORTANT (vie privée) : city est le seul champ de
  // localisation exposable publiquement — latitude/longitude ne doivent
  // jamais apparaître dans une réponse API publique (uniquement pour la
  // personne elle-même, ex. pour ré-afficher le formulaire d'édition).
  city           String?
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  travelRadiusKm Int?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?  // soft delete RGPD

  // Relations
  skills                  UserSkill[]
  oauthAccounts           OAuthAccount[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  otpCodes                OtpCode[]
  twoFactor               TwoFactor?
  workerProfile           WorkerProfile?
  recruiterProfile        RecruiterProfile?
  identityVerifications   IdentityVerification[] @relation("VerificationSubject")
  reviewedVerifications   IdentityVerification[] @relation("VerificationReviewer")
  jobsPosted              Job[]                  @relation("JobRecruiter")
  applications            Application[]          @relation("ApplicationWorker")
  wallets                 Wallet[]
  paymentsMade            Payment[]              @relation("PaymentPayer")
  escrowsAsRecruiter      Escrow[]               @relation("EscrowRecruiter")
  escrowsAsWorker         Escrow[]               @relation("EscrowWorker")
  withdrawals             Withdrawal[]
  invoices                Invoice[]
  disputesOpened          Dispute[]              @relation("DisputeOpener")
  disputesResolved        Dispute[]              @relation("DisputeResolver")
  reviewsAuthored         Review[]               @relation("ReviewAuthor")
  reviewsReceived         Review[]               @relation("ReviewTarget")
  reviewFlags             ReviewFlag[]
  conversationLinks       ConversationParticipant[]
  messagesSent            Message[]              @relation("MessageSender")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  deviceTokens            DeviceToken[]
  savedJobs               SavedJob[]
  jobAlerts               JobAlert[]
  searchHistory           SearchHistory[]
  matchScores             MatchScore[]           @relation("MatchScoreWorker")
  fraudSignals            FraudSignal[]
  auditLogs               AuditLog[]             @relation("AuditActor")
  subscriptions           Subscription[]

  @@index([status])
  @@index([countryCode])
  @@map("users")
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique // on ne stocke jamais le token en clair
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @db.Uuid // chaînage de rotation
  deviceInfo        String?
  ipAddress         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique // on ne stocke jamais le token en clair
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model OtpCode {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String?    @db.Uuid
  target    String     // téléphone ou email visé
  channel   OtpChannel
  codeHash  String     // hash du code, jamais en clair
  purpose   OtpPurpose
  attempts  Int        @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([target, purpose])
  @@map("otp_codes")
}

model TwoFactor {
  userId          String          @id @db.Uuid
  method          TwoFactorMethod
  secretEncrypted String          // secret TOTP chiffré (AES-256)
  enabledAt       DateTime?
  createdAt       DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factors")
}

model WorkerProfile {
  userId             String      @id @db.Uuid
  displayName        String
  bio                String?
  avatarUrl          String?
  hourlyRateAmount   BigInt?     // unités mineures
  hourlyRateCurrency String?     // ISO 4217
  level              WorkerLevel @default(BEGINNER)
  completedJobsCount Int         @default(0)
  isIdentityVerified Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills WorkerSkill[]
  experiences Experience[]

  @@index([level])
  @@map("worker_profiles")
}

model RecruiterProfile {
  userId      String        @id @db.Uuid
  type        RecruiterType @default(INDIVIDUAL)
  companyName String?
  websiteUrl  String?
  bio         String?
  avatarUrl   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recruiter_profiles")
}

model Skill {
  id        String        @id @default(uuid()) @db.Uuid
  key       String        @unique // clé i18n, ex. "skill.plumbing"
  labelKey  String        // clé de libellé traduit
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  workers WorkerSkill[]
  jobs    JobSkill[]
  users   UserSkill[]

  @@map("skills")
}

model WorkerSkill {
  workerProfileId String @db.Uuid
  skillId         String @db.Uuid

  worker WorkerProfile @relation(fields: [workerProfileId], references: [userId], onDelete: Cascade)
  skill  Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([workerProfileId, skillId])
  @@index([skillId])
  @@map("worker_skills")
}

/// Compétences directement rattachées à User (profil polyvalent) — distinct
/// de WorkerSkill/WorkerProfile, qui restent non utilisés par l'app.
model UserSkill {
  userId  String @db.Uuid
  skillId String @db.Uuid

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model Experience {
  id              String    @id @default(uuid()) @db.Uuid
  workerProfileId String    @db.Uuid
  title           String
  description     String?
  startDate       DateTime?
  endDate         DateTime?

  worker WorkerProfile @relation(fields: [workerProfileId], references: [userId], onDelete: Cascade)

  @@index([workerProfileId])
  @@map("experiences")
}

model IdentityVerification {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @db.Uuid
  status           VerificationStatus @default(PENDING)
  documentType     IdDocumentType
  documentFrontUrl String
  documentBackUrl  String?
  selfieUrl        String
  rejectionReason  String?
  reviewedById     String?            @db.Uuid
  submittedAt      DateTime           @default(now())
  reviewedAt       DateTime?

  user       User  @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("identity_verifications")
}

// ═══════════════════════════════════════════════════════════════════════════
//  MODULE 2 & 3 — MISSIONS, CATÉGORIES, RECHERCHE
// ═══════════════════════════════════════════════════════════════════════════

model JobCategory {
  id        String        @id @default(uuid()) @db.Uuid
  key       String        @unique // ex. "category.delivery"
  labelKey  String
  iconUrl   String?
  parentId  String?       @db.Uuid
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  parent   JobCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children JobCategory[] @relation("CategoryTree")
  jobs     Job[]

  @@index([parentId])
  @@map("job_categories")
}

model Job {
  id             String              @id @default(uuid()) @db.Uuid
  recruiterId    String              @db.Uuid
  categoryId     String              @db.Uuid
  title          String
  description    String
  salaryAmount   BigInt?             // unités mineures — absent = rémunération à négocier
  salaryCurrency String?             // ISO 4217 — absent = rémunération à négocier
  salaryType     SalaryType          @default(FIXED)
  durationMinutes Int?
  startAt        DateTime?
  urgency        JobUrgency          @default(FLEXIBLE)
  workersNeeded  Int                 @default(1)
  status         JobStatus           @default(DRAFT)
  recurrence     RecurrenceFrequency @default(NONE)

  // Localisation — libre, jamais de structure imposée par région.
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  addressText String?
  city        String?
  countryCode String?  // ISO 3166-1 alpha-2

  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recruiter    User          @relation("JobRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  category     JobCategory   @relation(fields: [categoryId], references: [id])
  requiredSkills JobSkill[]
  photos       JobPhoto[]
  applications Application[]
  boosts       JobBoost[]
  savedBy      SavedJob[]
  conversation Conversation?
  escrows      Escrow[]
  reviews      Review[]
  matchScores  MatchScore[]

  @@index([status, urgency])
  @@index([categoryId])
  @@index([recruiterId])
  @@index([latitude, longitude])
  @@index([countryCode])
  @@map("jobs")
}

model JobSkill {
  jobId   String @db.Uuid
  skillId String @db.Uuid

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

model JobPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @db.Uuid
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_photos")
}

model JobBoost {
  id        String    @id @default(uuid()) @db.Uuid
  jobId     String    @db.Uuid
  tier      String    // niveau de mise en avant, configurable
  amount    BigInt
  currency  String
  paymentId String?   @db.Uuid
  startsAt  DateTime  @default(now())
  endsAt    DateTime
  createdAt DateTime  @default(now())

  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@map("job_boosts")
}

model SavedJob {
  userId    String   @db.Uuid
  jobId     String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@index([jobId])
  @@map("saved_jobs")
}

model JobAlert {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  criteria  Json     // filtres sauvegardés (catégorie, rayon, salaire min…)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("job_alerts")
}

model SearchHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  query     String?
  filters   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("search_history")
}

// ═══════════════════════════════════════════════════════════════════════════
//  MODULE 4 — CANDIDATURES
// ═══════════════════════════════════════════════════════════════════════════

model Application {
  id                  String            @id @default(uuid()) @db.Uuid
  jobId               String            @db.Uuid
  workerId            String            @db.Uuid
  status              ApplicationStatus @default(PENDING)
  coverLetter         String?
  proposedRateAmount  BigInt?
  proposedRateCurrency String?
  matchScore          Float?            // score IA visible par le recruteur
  decisionMessage     String?
  // true si créée par le recruteur (réinvitation d'un travailleur déjà
  // connu) plutôt que par le travailleur qui postule — inverse qui doit
  // accepter/refuser (le travailleur, pas le recruteur).
  invitedByRecruiter  Boolean           @default(false)
  createdAt           DateTime          @default(now())
  decidedAt           DateTime?

  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker User @relation("ApplicationWorker", fields: [workerId], references: [id], onDelete: Cascade)
  escrow Escrow?

  @@unique([jobId, workerId])
  @@index([workerId, status])
  @@index([jobId, status])
  @@map("applications")
}

// ═══════════════════════════════════════════════════════════════════════════
//  MODULE 6 — MESSAGERIE TEMPS RÉEL
// ═══════════════════════════════════════════════════════════════════════════

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String?  @unique @db.Uuid // conversation liée à une mission
  createdAt DateTime @default(now())

  job          Job?                      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  senderId       String      @db.Uuid
  type           MessageType @default(TEXT)
  body           String?
  attachmentUrl  String?
  latitude       Decimal?    @db.Decimal(9, 6)
  longitude      Decimal?    @db.Decimal(9, 6)
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ═══════════════════════════════════════════════════════════════════════════
//  MODULE 7 — PAIEMENTS, WALLET, ESCROW
// ═══════════════════════════════════════════════════════════════════════════

model Wallet {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  currency       String   // ISO 4217 — un wallet par devise
  balance        BigInt   @default(0) // solde disponible, unités mineures
  pendingBalance BigInt   @default(0) // fonds en attente (escrow, retrait)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  withdrawals  Withdrawal[]

  @@unique([userId, currency])
  @@map("wallets")
}

// Grand livre en écriture unique (append-only) : chaque mouvement laisse une trace.
model WalletTransaction {
  id           String          @id @default(uuid()) @db.Uuid
  walletId     String          @db.Uuid
  type         WalletTxnType
  reason       WalletTxnReason
  amount       BigInt          // toujours positif ; le signe vient de `type`
  currency     String
  balanceAfter BigInt
  referenceId  String?         @db.Uuid // escrow / payment / withdrawal lié
  metadata     Json?
  createdAt    DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model Payment {
  id           String             @id @default(uuid()) @db.Uuid
  payerId      String             @db.Uuid
  provider     PaymentProviderKey
  providerRef  String?            // identifiant de transaction côté provider
  amount       BigInt
  currency     String
  purpose      PaymentPurpose
  status       PaymentStatus      @default(PENDING)
  metadata     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  payer     User       @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Cascade)
  escrow    Escrow?
  boosts    JobBoost[]
  invoices  Invoice[]

  @@index([payerId])
  @@index([status])
  @@index([provider, providerRef])
  @@map("payments")
}

model Escrow {
  id               String       @id @default(uuid()) @db.Uuid
  jobId            String       @db.Uuid
  applicationId    String       @unique @db.Uuid
  recruiterId      String       @db.Uuid
  workerId         String       @db.Uuid
  paymentId        String?      @unique @db.Uuid
  amount           BigInt       // montant dû au worker
  currency         String
  commissionAmount BigInt       @default(0) // commission plateforme prélevée
  status           EscrowStatus @default(PENDING)
  autoReleaseAt    DateTime?    // libération auto (ex. J+3) si pas d'action
  fundedAt         DateTime?
  releasedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recruiter   User        @relation("EscrowRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  worker      User        @relation("EscrowWorker", fields: [workerId], references: [id], onDelete: Cascade)
  payment     Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  dispute     Dispute?

  @@index([status, autoReleaseAt])
  @@index([jobId])
  @@map("escrows")
}

model Withdrawal {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  walletId    String           @db.Uuid
  amount      BigInt
  currency    String
  provider    PaymentProviderKey
  destination Json             // coordonnées de retrait (IBAN, numéro mobile money…)
  status      WithdrawalStatus @default(REQUESTED)
  providerRef String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("withdrawals")
}

model Invoice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  paymentId String?  @db.Uuid
  number    String   @unique // numéro de facture séquentiel par marché
  amount    BigInt
  currency  String
  pdfUrl    String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("invoices")
}

model Dispute {
  id             String        @id @default(uuid()) @db.Uuid
  escrowId       String        @unique @db.Uuid
  openedById     String        @db.Uuid
  reason         String
  status         DisputeStatus @default(OPEN)
  resolutionNote String?
  resolvedById   String?       @db.Uuid
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  escrow     Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  openedBy   User   @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Cascade)
  resolvedBy User?  @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("disputes")
}

model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  baseCurrency  String   // ISO 4217
  quoteCurrency String   // ISO 4217
  rate          Decimal  @db.Decimal(20, 8)
  fetchedAt     DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, fetchedAt])
  @@index([baseCurrency, quoteCurrency])
  @@map("exchange_rates")
}

// ═══════════════════════════════════════════════════════════════════════════
//  MODULE 8 — RÉPUTATION
// ═══════════════════════════════════════════════════════════════════════════

model Review {
  id            String          @id @default(uuid()) @db.Uuid
  jobId         String          @db.Uuid
  authorId      String          @db.Uuid
  targetId      String          @db.Uuid
  direction     ReviewDirection
  rating        Int             // note globale 1-5
  punctuality   Int?
  quality       Int?
  communication Int?
  compliance    Int?
  comment       String?
  response      String?         // réponse de la personne évaluée
  status        ReviewStatus    @default(VISIBLE)
  createdAt     DateTime        @default(now())

  job    Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  author User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target User         @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  flags  ReviewFlag[]

  @@unique([jobId, authorId, targetId])
  @@index([targetId, status])
  @@map("reviews")
}

model ReviewFlag {
  id           String   @id @default(uuid()) @db.Uuid
  reviewId     String   @db.Uuid
  reportedById String   @db.Uuid
  reason       String
  createdAt    DateTime @default(now())

  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reportedBy User   @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@unique([reviewId, reportedById])
  @@map("review_flags")
}

// ═══════════════════════════════════════════════════════════════════════════
//  MODULE 9 — NOTIFICATIONS
// ═══════════════════════════════════════════════════════════════════════════

model Notification {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String                @db.Uuid
  type         String                // clé i18n du type de notification
  title        String
  body         String
  data         Json?
  channelsSent NotificationChannel[]
  readAt       DateTime?
  createdAt    DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id       String              @id @default(uuid()) @db.Uuid
  userId   String              @db.Uuid
  category String              // ex. "new_match", "payment", "message"
  channel  NotificationChannel
  enabled  Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, channel])
  @@map("notification_preferences")
}

model DeviceToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  token     String         @unique
  platform  DevicePlatform
  provider  PushProvider
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ═══════════════════════════════════════════════════════════════════════════
//  MODULE 10 — IA / MATCHING / FRAUDE
// ═══════════════════════════════════════════════════════════════════════════

model MatchScore {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @db.Uuid
  workerId  String   @db.Uuid
  score     Float    // 0-100, agrégat multi-critères
  breakdown Json     // détail par critère (distance, skills, note…)
  createdAt DateTime @default(now())

  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker User @relation("MatchScoreWorker", fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([jobId, workerId])
  @@index([workerId, score])
  @@map("match_scores")
}

// Pointeur vers un vecteur stocké dans Pinecone (aucun vecteur en base).
model EmbeddingRef {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   // "job" | "worker_profile"
  entityId   String   @db.Uuid
  pineconeId String   @unique
  model      String   // modèle d'embedding utilisé
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId])
  @@map("embedding_refs")
}

model FraudSignal {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String?           @db.Uuid
  entityType String            // "user" | "job" | "payment" | "review"
  entityId   String            @db.Uuid
  type       FraudSignalType
  severity   Int               @default(1) // 1 (faible) → 5 (critique)
  details    Json?
  status     FraudSignalStatus @default(OPEN)
  createdAt  DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, severity])
  @@index([entityType, entityId])
  @@map("fraud_signals")
}

// ═══════════════════════════════════════════════════════════════════════════
//  MODULE 11 — ADMIN, CONFIGURATION PAR MARCHÉ, MONÉTISATION
// ═══════════════════════════════════════════════════════════════════════════

// Un « marché » = un pays activé, avec ses défauts. Tout est modifiable en admin.
model Market {
  id              String   @id @default(uuid()) @db.Uuid
  countryCode     String   @unique // ISO 3166-1 alpha-2
  name            String
  defaultCurrency String   // ISO 4217
  defaultLocale   String   // BCP 47
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("markets")
}

// Clé/valeur de configuration. countryCode NULL = valeur globale par défaut.
// Contient : commission_rate, min_salary, payment_providers_enabled,
// supported_currencies, kyc_required, withdrawal_min_amount,
// job_categories_visible, etc.
model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  countryCode String?  // NULL = défaut global
  key         String
  value       Json
  updatedAt   DateTime @updatedAt

  @@unique([countryCode, key])
  @@index([key])
  @@map("system_configs")
}

model FeatureFlag {
  key       String   @id
  isEnabled Boolean  @default(false)
  rollout   Json?    // ciblage progressif (pourcentage, marché, rôle…)
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}

// Table d'audit immuable (append-only). Aucune update/delete applicative.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   // ex. "escrow.release", "user.ban"
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  plan           SubscriptionPlan   @default(FREE)
  status         SubscriptionStatus @default(ACTIVE)
  priceAmount    BigInt             @default(0)
  currency       String             @default("USD")
  provider       PaymentProviderKey?
  providerRef    String?
  currentPeriodEnd DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscriptions")
}

// ═══════════════════════════════════════════════════════════════════════════
//  RÉFÉRENTIELS (seedés, jamais hardcodés dans le code applicatif)
// ═══════════════════════════════════════════════════════════════════════════

model Currency {
  code     String @id // ISO 4217, ex. "EUR"
  symbol   String
  name     String
  decimals Int    @default(2) // nombre d'unités mineures (0 pour JPY, XOF…)

  @@map("currencies")
}

model Country {
  code            String @id // ISO 3166-1 alpha-2
  name            String
  dialCode        String // ex. "+225"
  defaultCurrency String // ISO 4217
  defaultLocale   String // BCP 47

  @@map("countries")
}

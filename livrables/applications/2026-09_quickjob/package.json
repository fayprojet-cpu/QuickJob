{
  "name": "quickjob",
  "private": true,
  "version": "0.1.0",
  "description": "QuickJob — plateforme universelle de travail temporaire (monorepo).",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "prisma:generate": "pnpm --filter @quickjob/api prisma:generate",
    "prisma:migrate": "pnpm --filter @quickjob/api prisma:migrate",
    "prisma:deploy": "pnpm --filter @quickjob/api prisma:deploy",
    "prisma:seed": "pnpm --filter @quickjob/api prisma:seed",
    "prisma:studio": "pnpm --filter @quickjob/api prisma:studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "turbo": "2.10.13",
    "typescript": "6.0.3"
  }
}

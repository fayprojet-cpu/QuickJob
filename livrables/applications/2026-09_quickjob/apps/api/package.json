{
  "name": "@quickjob/api",
  "version": "0.1.0",
  "private": true,
  "description": "QuickJob API — NestJS (REST + Swagger).",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "echo \"(lint) no linter configured yet\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "clean": "rimraf dist coverage",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../../prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "prisma:seed": "ts-node --transpile-only --project tsconfig.json ../../prisma/seed.ts",
    "prisma:studio": "prisma studio --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "6.19.3",
    "@quickjob/config": "workspace:*",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "nodemailer": "10.0.10",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/ms": "2.1.0",
    "@types/nodemailer": "8.0.2",
    "@types/node": "26.5.1",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.1",
    "rimraf": "6.0.1",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}

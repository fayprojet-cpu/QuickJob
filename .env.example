# ═══════════════════════════════════════════════════════════════════
#  .env.example — Template public des variables d'environnement
# ═══════════════════════════════════════════════════════════════════
#
#  Ce fichier NE contient JAMAIS de vraie valeur. Il sert de modèle :
#  il liste les variables attendues et peut être versionné sans risque.
#
#  Pour l'utiliser : copie-le en `.env`, puis remplis tes clés dedans.
#      cp .env.example .env
#
#  Le fichier `.env` (avec tes vraies clés) est, lui, ignoré par Git.
# ═══════════════════════════════════════════════════════════════════

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Notion ---
NOTION_API_KEY=

# --- Google (Cloud / OAuth) ---
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- YouTube Data API ---
YOUTUBE_API_KEY=

# --- Vercel ---
VERCEL_TOKEN=

# --- GitHub ---
GITHUB_TOKEN=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
